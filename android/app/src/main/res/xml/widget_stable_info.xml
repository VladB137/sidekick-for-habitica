<?xml version="1.0" encoding="utf-8"?>
<!-- Redrawn when the app sends new pictures and at each light of the day (an alarm that doesn't wake the phone); never on its own timer -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_stable"
    android:previewImage="@drawable/widget_stable_preview"
    android:description="@string/stable_widget_description"
    android:updatePeriodMillis="0" />
